    -- Speed System Functions
    local function toggleSpeed()
        speedEnabled = not speedEnabled
        if speedEnabled then
            SpeedToggle.Text = "TOGGLE SPEED [ON]"
            SpeedToggle.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
            Humanoid.WalkSpeed = math.clamp(walkSpeed, speedProtection.minSpeed, speedProtection.maxSpeed)
        else
            SpeedToggle.Text = "TOGGLE SPEED [OFF]"
            SpeedToggle.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            Humanoid.WalkSpeed = originalWalkSpeed
        end
    end

    local function adjustSpeed(amount)
        walkSpeed = math.clamp(walkSpeed + amount, speedProtection.minSpeed, speedProtection.maxSpeed)
        SpeedValue.Text = tostring(walkSpeed)
        if speedEnabled then
            Humanoid.WalkSpeed = walkSpeed
        end
    end

    -- Noclip System
    local function toggleNoclip()
        noclip = not noclip
        if noclip then
            NoclipToggle.Text = "NOCLIP [ON]"
            NoclipToggle.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
            
            noclipConnection = RunService.Stepped:Connect(function()
                if noclip and Character then
                    for _, part in pairs(Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        else
            NoclipToggle.Text = "NOCLIP [OFF]"
            NoclipToggle.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            
            if noclipConnection then
                noclipConnection:Disconnect()
            end
            
            if Character then
                for _, part in pairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
    end

    -- Invisibility System
    local function toggleInvisibility()
        if not Character then return end
        
        invisEnabled = not invisEnabled
        if invisEnabled then
            InvisToggle.Text = "INVIS [ON]"
            InvisToggle.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
            
            -- Save original transparency
            for _, part in pairs(Character:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("Decal") then
                    originalTransparency[part] = part.Transparency
                    part.Transparency = 1
                end
            end
            
            -- Create invisible seat
            local savedPos = Character.HumanoidRootPart.CFrame
            Character:MoveTo(Vector3.new(0, -500, 0))
            wait(0.1)
            
            invisSeat = Instance.new("Seat")
            invisSeat.Anchored = false
            invisSeat.CanCollide = false
            invisSeat.Transparency = 1
            invisSeat.Name = "InvisSeat"
            invisSeat.Parent = workspace
            invisSeat.CFrame = savedPos
            
            -- Weld character to seat
            local weld = Instance.new("Weld")
            weld.Part0 = invisSeat
            weld.Part1 = Character:FindFirstChild("HumanoidRootPart") or 
                         Character:FindFirstChild("Torso") or 
                         Character:FindFirstChild("UpperTorso")
            weld.Parent = invisSeat
        else
            InvisToggle.Text = "INVIS [OFF]"
            InvisToggle.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            
            -- Restore original transparency
            for part, transparency in pairs(originalTransparency) do
                if part and part.Parent then
                    part.Transparency = transparency
                end
            end
            
            -- Remove invis seat
            if invisSeat then
                invisSeat:Destroy()
                invisSeat = nil
            end
        end
    end

    -- Connect GUI buttons
    FlyToggle.MouseButton1Click:Connect(toggleFly)
    SpeedToggle.MouseButton1Click:Connect(toggleSpeed)
    SpeedInc.MouseButton1Click:Connect(function() adjustSpeed(5) end)
    SpeedDec.MouseButton1Click:Connect(function() adjustSpeed(-5) end)
    
    -- التعديل هنا: +5 عند الزيادة و -2 عند النقصان
    FlySpeedInc.MouseButton1Click:Connect(function()
        flySpeed = math.min(flySpeed + 5, 1000) -- زيادة 5 عند الضغط على +
        FlySpeedValue.Text = tostring(flySpeed)
    end)

    FlySpeedDec.MouseButton1Click:Connect(function()
        flySpeed = math.max(flySpeed - 2, 1) -- نقصان 2 عند الضغط على -
        FlySpeedValue.Text = tostring(flySpeed)
    end)
    
    NoclipToggle.MouseButton1Click:Connect(toggleNoclip)
    InvisToggle.MouseButton1Click:Connect(toggleInvisibility)

    -- Hide/Show GUI
    HideButton.MouseButton1Click:Connect(function()
        Frame.Visible = false
        HideButton.Visible = false
        UnhideButton.Visible = true
    end)

    UnhideButton.MouseButton1Click:Connect(function()
        Frame.Visible = true
        HideButton.Visible = true
        UnhideButton.Visible = false
    end)

    -- Teleport System (M3)
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.UserInputType == Enum.UserInputType.MouseButton3 then
            local mouse = Player:GetMouse()
            local target = mouse.Hit.Position
            if Character and Character:FindFirstChild("HumanoidRootPart") then
                Character.HumanoidRootPart.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
            end
        end
    end)

    -- Reload GUI
    ReloadButton.MouseButton1Click:Connect(function()
        main:Destroy()
        wait(0.5)
        createGUI()
        initializeCharacter()
    end)

    -- Close GUI
    CloseButton.MouseButton1Click:Connect(function()
        main:Destroy()
    end)

    -- Speed Protection
    RunService.Heartbeat:Connect(function()
        if speedEnabled and Humanoid then
            if Humanoid.WalkSpeed ~= walkSpeed then
                Humanoid.WalkSpeed = walkSpeed
            end
        end
    end)
end

-- Initialize Character
local function initializeCharacter()
    Character = Player.Character or Player.CharacterAdded:Wait()
    Humanoid = Character:WaitForChild("Humanoid")
    originalWalkSpeed = Humanoid.WalkSpeed
    
    -- Update GUI if exists
    if SpeedValue then
        SpeedValue.Text = tostring(originalWalkSpeed)
    end
    
    -- Reset states when character changes
    if flying then toggleFly() end
    if noclip then toggleNoclip() end
    if invisEnabled then toggleInvisibility() end
    
    -- Apply speed if enabled
    if speedEnabled then
        Humanoid.WalkSpeed = walkSpeed
    else
        Humanoid.WalkSpeed = originalWalkSpeed
    end
end

-- Character Added Event
Player.CharacterAdded:Connect(function(character)
    repeat wait() until character:FindFirstChild("Humanoid")
    initializeCharacter()
end)

-- Initialize
createGUI()
initializeCharacter()

