    -- Fly System Functions
    local function toggleFly()
        if flying then
            -- Disable fly
            if flyConnection then flyConnection:Disconnect() end
            
            if Humanoid then
                for state, enabled in pairs(originalStates) do
                    Humanoid:SetStateEnabled(state, enabled)
                end
                Humanoid.PlatformStand = false
                Humanoid:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
            end
            
            -- Remove fly parts
            local torso = Character and (Character:FindFirstChild("HumanoidRootPart") or 
                     Character:FindFirstChild("UpperTorso") or 
                     Character:FindFirstChild("Torso"))
            if torso then
                for _, v in pairs({"BodyGyro", "BodyVelocity"}) do
                    local part = torso:FindFirstChild(v)
                    if part then part:Destroy() end
                end
            end
            
            flying = false
            FlyToggle.Text = "TOGGLE FLY [OFF]"
            FlyToggle.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        else
            -- Enable fly
            if not Character or not Humanoid then return end
            
            -- Save original states
            for _, state in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
                originalStates[state] = Humanoid:GetStateEnabled(state)
                Humanoid:SetStateEnabled(state, false)
            end
            Humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
            
            -- Create fly parts
            local torso = Character:FindFirstChild("HumanoidRootPart") or 
                         Character:FindFirstChild("UpperTorso") or 
                         Character:FindFirstChild("Torso")
            if not torso then return end
            
            local bg = Instance.new("BodyGyro", torso)
            bg.P = 9e4
            bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.cframe = torso.CFrame
            
            local bv = Instance.new("BodyVelocity", torso)
            bv.velocity = Vector3.new(0, 0.1, 0)
            bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
            
            -- Fly control loop
            flyConnection = RunService.Stepped:Connect(function()
                if not flying or not Character or not Humanoid then
                    if flyConnection then flyConnection:Disconnect() end
                    return
                end
                
                Humanoid.PlatformStand = true
                
                local speed = (ctrl.f + ctrl.b ~= 0 or ctrl.l + ctrl.r ~= 0) and (25 * flySpeed) or 0
                
                if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
                    bv.velocity = ((workspace.CurrentCamera.CoordinateFrame.lookVector * (ctrl.f + ctrl.b)) + 
                                 ((workspace.CurrentCamera.CoordinateFrame * CFrame.new(ctrl.l + ctrl.r, (ctrl.f + ctrl.b) * 0.2, 0).p) - 
                                 workspace.CurrentCamera.CoordinateFrame.p)) * speed
                else
                    bv.velocity = Vector3.new(0, 0.1, 0)
                end
                
                bg.cframe = workspace.CurrentCamera.CoordinateFrame * CFrame.Angles(-math.rad((ctrl.f + ctrl.b) * 50 * speed / 100), 0, 0)
            end)
            
            flying = true
            FlyToggle.Text = "TOGGLE FLY [ON]"
            FlyToggle.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
        end
    end

    -- Fly Controls
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or not flying then return end
        
        if input.KeyCode == Enum.KeyCode.W then
            ctrl.f = 1
        elseif input.KeyCode == Enum.KeyCode.S then
            ctrl.b = -1
        elseif input.KeyCode == Enum.KeyCode.A then
            ctrl.l = -1
        elseif input.KeyCode == Enum.KeyCode.D then
            ctrl.r = 1
        end
    end)

    UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if gameProcessed or not flying then return end
        
        if input.KeyCode == Enum.KeyCode.W then
            ctrl.f = 0
        elseif input.KeyCode == Enum.KeyCode.S then
            ctrl.b = 0
        elseif input.KeyCode == Enum.KeyCode.A then
            ctrl.l = 0
        elseif input.KeyCode == Enum.KeyCode.D then
            ctrl.r = 0
        end
    end)

    -- Vertical Flight
    local function flyVertical(direction)
        if not flying then return end
        local root = Character and Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = root.CFrame + Vector3.new(0, direction * flySpeed * 0.5, 0)
        end
    end

